BEARER_TOKEN=change-me-to-a-long-random-secret
PORT=3000

# Optional - only needed for the "llm" provider.
# Default setup works with a free Groq key (console.groq.com), no credit
# card needed. See README "LLM provider setup" for other free options.
LLM_API_KEY=your_groq_api_key_here #get new key from console.groq.com
LLM_API_STYLE=openai
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions 
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=20000
